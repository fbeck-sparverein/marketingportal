{#- Karte für eine Aktion – überall gleich aufgebaut. Erwartet: k (Kampagne) -#}
{%- from "partials/icons.njk" import icon -%}
{%- set st = k.data | status -%}
{%- set bild = k.data.kartenbild or k.data.bild -%}
<a class="akarte akarte--{{ st.code }}{% if bild %} akarte--bild{% endif %}" href="{{ ('/aktionen/' + k.fileSlug + '/') | url }}"
   data-start="{{ k.data.start }}" data-ende="{{ k.data.ende }}" data-dauerhaft="{{ 'ja' if k.data.dauerhaft }}">
  {%- if bild %}
  <div class="akarte__bild"><img src="{{ bild | verkleinert(800) | url }}" alt="" loading="lazy"></div>
  {%- endif %}
  <div class="akarte__kopf">
    <span class="chip chip--{{ st.code }} js-status">{{ st.text }}</span>
    <span class="akarte__typ">{{ k.data.typ }}</span>
  </div>
  <h3 class="akarte__titel">{{ k.data.title }}{% if k.data.untertitel %} <span>{{ k.data.untertitel }}</span>{% endif %}</h3>
  <p class="akarte__zeit">{{ icon("kalender", 16) }} {{ k.data.zeitraum }}</p>
  {%- if k.data.highlights and k.data.highlights.length %}
  <ul class="akarte__highlights">
    {%- for h in k.data.highlights %}<li>{{ h }}</li>{% endfor %}
  </ul>
  {%- else %}
  <p class="akarte__teaser">{{ k.data.teaser }}</p>
  {%- endif %}
  <span class="akarte__cta">Formate &amp; Infos {{ icon("pfeil", 18) }}</span>
</a>
