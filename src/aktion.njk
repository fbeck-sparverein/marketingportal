---
layout: layouts/base.njk
pagination:
  data: collections.kampagnen
  size: 1
  alias: k
permalink: "/aktionen/{{ k.fileSlug }}/"
eleventyComputed:
  title: "{{ k.data.title }}"
---
{%- from "partials/icons.njk" import icon -%}
{%- set st = k.data | status -%}
{%- set alle = collections.formate | formateVon(k.fileSlug) -%}
{%- set kopfbild = k.data.kartenbild or k.data.bild -%}

<section class="aktion-kopf aktion-kopf--bild{% if not kopfbild %} aktion-kopf--ohne-bild{% endif %}" data-start="{{ k.data.start }}" data-ende="{{ k.data.ende }}" data-dauerhaft="{{ 'ja' if k.data.dauerhaft }}">
  <div class="container aktion-kopf__grid">
    <div>
      <a class="aktion-kopf__zurueck" href="{{ '/aktionen/' | url }}">{{ icon("pfeil", 16) }} Alle Aktionen</a>
      <p class="aktion-kopf__meta"><span class="chip chip--{{ st.code }} js-status">{{ st.text }}</span> <span>{{ k.data.typ }}</span></p>
      <h1>{{ k.data.title }}{% if k.data.untertitel %}<span class="untertitel">{{ k.data.untertitel }}</span>{% endif %}</h1>
      <p class="lead">{{ k.data.teaser }}</p>
      <div class="aktion-kopf__knoepfe">
        <a class="btn btn--primaer" href="#formate">Zu den Formaten {{ icon("runter", 18) }}</a>
        {% if k.data.steckbrief %}<a class="btn btn--hell" href="{{ k.data.steckbrief.link }}">{{ icon("dokument", 18) }} {{ k.data.steckbrief.text }} <small>{{ k.data.steckbrief.typ or "PDF" }}{% if k.data.steckbrief.groesse %}, {{ k.data.steckbrief.groesse }}{% endif %}</small></a>{% endif %}
      </div>
    </div>
    {%- if kopfbild %}<figure class="kopfbild"><img src="{{ kopfbild | verkleinert(1200) | url }}" alt="Kampagnenmotiv {{ k.data.title }}"></figure>{% endif %}
  </div>
</section>
<section class="band band--prosa">
  <div class="container aktion-text">
    <div class="prosa">{{ k.templateContent | safe }}</div>
    <aside class="eckdaten" aria-label="Auf einen Blick">
      <h2 class="eckdaten__titel">Auf einen Blick</h2>
      <dl>
        <div><dt>{{ icon("kalender", 18) }} Zeitraum</dt><dd>{{ k.data.zeitraum }}</dd></div>
        {%- if k.data.verlosung %}<div><dt>{{ icon("uhr", 18) }} Verlosung</dt><dd>{{ k.data.verlosung }}</dd></div>{% endif %}
        {%- if k.data.highlights and k.data.highlights.length %}
        <div><dt>{{ icon("stern", 18) }} Highlights</dt><dd><ul>{% for h in k.data.highlights %}<li>{{ h }}</li>{% endfor %}</ul></dd></div>
        {%- endif %}
      </dl>
    </aside>
  </div>
  {%- if k.data.beispiele and k.data.beispiele.length %}
  <div class="container beispiele">
    <h2 class="beispiele__titel">So sieht's im Einsatz aus</h2>
    <ul class="beispiele__raster">
      {%- for b in k.data.beispiele %}
      <li><a class="js-gross" href="{{ b.bild | url }}" data-titel="{{ b.beschriftung }}"><img src="{{ b.bild | verkleinert(720) | url }}" alt="{{ b.beschriftung or 'Beispiel' }}" loading="lazy">{% if b.beschriftung %}<span>{{ b.beschriftung }}</span>{% endif %}</a></li>
      {%- endfor %}
    </ul>
  </div>
  <dialog class="leuchtkasten" id="leuchtkasten" aria-label="Beispiel in groß">
    <button class="leuchtkasten__zu icon-btn" type="button" aria-label="Schließen">{{ icon("x", 22) }}</button>
    <button class="leuchtkasten__pfeil leuchtkasten__pfeil--zurueck" type="button" aria-label="Vorheriges Beispiel">‹</button>
    <figure><img alt=""><figcaption></figcaption></figure>
    <button class="leuchtkasten__pfeil leuchtkasten__pfeil--vor" type="button" aria-label="Nächstes Beispiel">›</button>
  </dialog>
  {%- endif %}
</section>

<section class="band band--grau" id="formate">
  <div class="container">
    <div class="abschnitt-kopf abschnitt-kopf--zeile">
      <h2>Formate zur Aktion</h2>
      <span class="hinweis-klein">{{ alle | anzahlDateien }} Dateien</span>
    </div>

    <div class="reiter" role="tablist" aria-label="Formate nach Zielgruppe">
      {%- for z in zielgruppen %}
      {%- set liste = collections.formate | formateVon(k.fileSlug, z.schluessel) %}
      {%- if liste | length %}
      <button class="reiter__knopf js-reiter" role="tab" type="button" id="tab-{{ z.schluessel }}" aria-controls="panel-{{ z.schluessel }}" data-ziel="{{ z.schluessel }}" aria-selected="{{ 'true' if loop.first else 'false' }}">
        {{ z.titel }} <span class="zahl">{{ liste | anzahlDateien }}</span>
      </button>
      {%- endif %}
      {%- endfor %}
    </div>

    {%- for z in zielgruppen %}
    {%- set liste = collections.formate | formateVon(k.fileSlug, z.schluessel) %}
    {%- if liste | length %}
    <div class="reiter__panel" role="tabpanel" id="panel-{{ z.schluessel }}" aria-labelledby="tab-{{ z.schluessel }}" data-ziel="{{ z.schluessel }}"{% if not loop.first %} hidden{% endif %}>
      {%- if liste | length > 1 %}
      <nav class="sprungmarken" aria-label="Kanäle">{% for f in liste %}<a href="#{{ f.fileSlug }}">{{ f.data.title }} <span>{{ f.data.dateien | length }}</span></a>{% endfor %}</nav>
      {%- endif %}
      {%- for f in liste %}
      <article class="kanal" id="{{ f.fileSlug }}">
        <header class="kanal__kopf">
          <div><h3>{{ f.data.title }}</h3>{% if f.data.beschreibung %}<p>{{ f.data.beschreibung }}</p>{% endif %}</div>
        </header>
        {% set dateien = f.data.dateien %}{% include "partials/dateien.njk" %}
      </article>
      {%- endfor %}
    </div>
    {%- endif %}
    {%- endfor %}
  </div>
</section>

<section class="band">
  <div class="container">
    <div class="abschnitt-kopf"><h2>Weitere Aktionen</h2></div>
    <div class="aktionen-raster aktionen-raster--klein">
      {%- set dieseAktion = k.fileSlug %}{%- asyncEach k2 in collections.kampagnen | aktuelleZuerst %}{% ifAsync k2.fileSlug != dieseAktion %}{% set k = k2 %}{% include "partials/aktionskarte.njk" %}{% endif %}{% endeach %}
    </div>
  </div>
</section>
